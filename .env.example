# Copy to `.env.local` for local work, and set the same keys in the Vercel
# Project → Settings → Environment Variables for deployments.
#
# .env* is gitignored — never commit real values. This example is the contract.

# Absolute public origin of the site. Drives canonical URLs, hreflang, OpenGraph,
# the sitemap and robots. MUST be set on the Production environment, or metadata
# falls back to the Vercel deploy URL (preview) or http://localhost:3000 (local).
#
# No trailing slash. Include the protocol.
#   Production example: https://chem.knu.ua
#   Local example:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Provided automatically by Vercel; do NOT set these yourself ---
# VERCEL_ENV                     "production" | "preview" | "development"
# VERCEL_PROJECT_PRODUCTION_URL  stable production domain (fallback origin)
# VERCEL_URL                     per-deployment URL (preview fallback origin)
